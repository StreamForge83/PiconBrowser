#: ../plugin.py:91
msgid "A picon sync is already running."
msgstr "Ein Picon-Abgleich läuft bereits."

#: ../plugin.py:152 ../plugin.py:153
msgid "Close the preview"
msgstr "Vorschau schließen"

#: ../setup.xml
msgid "Exclude IPTV"
msgstr "IPTV ausschließen"

#: ../setup.xml
msgid "Exclude IPTV services from the channel list used to determine which picons are needed."
msgstr "IPTV-Dienste aus der Senderliste ausschließen, die zur Ermittlung der benötigten Picons verwendet wird."

#: ../setup.xml
msgid "Exclude Radio"
msgstr "Radio ausschließen"

#: ../setup.xml
msgid "Exclude radio services from the channel list used to determine which picons are needed."
msgstr "Radiosender aus der Senderliste ausschließen, die zur Ermittlung der benötigten Picons verwendet wird."

#: ../setup.xml
msgid "Local directory the picons are downloaded to (Single-path mode)."
msgstr "Lokales Verzeichnis, in das die Picons heruntergeladen werden (Einzelpfad-Modus)."

#: ../setup.xml
msgid "Picon Browser Settings"
msgstr "Picon Browser Einstellungen"

#: ../plugin.py:331
msgid "Picon Browser Sync"
msgstr "Picon Browser Abgleich"

#: ../setup.xml
msgid "Picon path"
msgstr "Picon-Pfad"

#: ../setup.xml
msgid "Picon repo for path %s"
msgstr "Picon-Repo für Pfad %s"

#: ../plugin.py:93
msgid "Picon sync started in the background."
msgstr "Picon-Abgleich wurde im Hintergrund gestartet."

#: ../plugin.py:413
msgid "PiconBrowser description"
msgstr ""

#: ../setup.xml
msgid "Scheduled sync"
msgstr "Geplanter Abgleich"

#: ../plugin.py:110
msgid "Select Picon Directory"
msgstr "Picon-Verzeichnis auswählen"

#: ../setup.xml
msgid "Select the picon repo to download into Picon path %s (see Picon Settings)."
msgstr "Picon-Repo auswählen, das in Picon-Pfad %s heruntergeladen werden soll (siehe Picon-Einstellungen)."

#: ../plugin.py:76
msgid "Show a preview image for each picon repo"
msgstr "Vorschaubild für jedes Picon-Repo anzeigen"

#: ../plugin.py:151
msgid "Show the next repo's preview"
msgstr "Vorschau des nächsten Repos anzeigen"

#: ../plugin.py:150
msgid "Show the previous repo's preview"
msgstr "Vorschau des vorherigen Repos anzeigen"

#: ../plugin.py:79
msgid "Start a manual picon sync now"
msgstr "Jetzt einen manuellen Picon-Abgleich starten"

#: ../plugin.py:74
msgid "Sync now"
msgstr "Jetzt abgleichen"

#: ../setup.xml
msgid "This plugin does not sync automatically. Add a 'Picon Browser Sync' task in the Scheduler plugin to run the sync periodically."
msgstr "Dieses Plugin gleicht nicht automatisch ab. Fügen Sie im Scheduler-Plugin eine Aufgabe „Picon Browser Abgleich“ hinzu, um den Abgleich regelmäßig auszuführen."

#: ../plugin.py:111
msgid "What do you want to set as the picon location?"
msgstr "Was möchten Sie als Picon-Speicherort festlegen?"
